HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Comma-separated exact proxy IPs or narrowly scoped CIDRs; empty disables forwarded headers.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.5/32
MYSQL_DSN=miniverse:local-development-only@tcp(127.0.0.1:3306)/miniverse?parseTime=true
APP_ENV=sandbox
RULECORE_ADDR=127.0.0.1:50051
# Only for local sandbox. Production adapters do not use this key.
SANDBOX_PLATFORM_SECRET=local-sandbox-not-a-platform-key
# Optional server-side chat-completions compatible endpoint for the AI companion.
# Without configuration only sandbox offers clearly marked demo replies.
COMPANION_CHAT_URL=
COMPANION_API_KEY=
COMPANION_MODEL=
PLAYER_PORT=18082
