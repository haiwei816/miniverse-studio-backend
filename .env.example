HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Comma-separated exact proxy IPs or narrowly scoped CIDRs; empty disables forwarded headers.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.5/32
MYSQL_DSN=miniverse:local-development-only@tcp(127.0.0.1:3306)/miniverse?parseTime=true
APP_ENV=sandbox
RULECORE_ADDR=127.0.0.1:50051
# Only for local sandbox. Production adapters do not use this key.
SANDBOX_PLATFORM_SECRET=local-sandbox-not-a-platform-key
# Optional server-side chat-completions compatible endpoint for the AI companion.
# Without configuration only sandbox offers clearly marked demo replies.
COMPANION_CHAT_URL=
COMPANION_API_KEY=
COMPANION_MODEL=
# Optional OpenAI or Anthropic Claude compatible endpoint for the AI Ops Agent (falls back to sandbox playbook when unset).
# OPS_AGENT_PROTOCOL accepts: auto (default), openai, anthropic
OPS_AGENT_PROTOCOL=
OPS_AGENT_URL=
OPS_AGENT_API_KEY=
OPS_AGENT_MODEL=
# Optional 32-byte key (64 hex chars or base64) to encrypt persisted Ops Agent API keys at rest.
OPS_AGENT_SECRET_KEY=
# Optional dedicated bearer token (>=16 chars) for Prometheus scraping GET /gm/system/metrics.
METRICS_BEARER_TOKEN=sandbox-metrics-scrape-token
# Optional Redis & Kafka/Redpanda endpoints (gracefully degrades when unset).
REDIS_ADDR=
KAFKA_BROKERS=
PLAYER_PORT=18082
