{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniVerse GM",
  "version": "0.1.0",
  "identifier": "app.miniverse.gm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MiniVerse GM",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "MiniVerse 运营控制台",
    "longDescription": "为 MiniVerse Studio 后台定制的桌面控制台：补发、审批、存档与日志查询。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
