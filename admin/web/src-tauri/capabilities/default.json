{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GM console: the API call goes through the Rust http plugin (no CORS, localhost only) and native notifications are used for new pending work.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:18080/*" },
        { "url": "http://127.0.0.1:18081/*" },
        { "url": "http://localhost:18080/*" },
        { "url": "http://localhost:18081/*" },
        { "url": "https://*/*" }
      ]
    }
  ]
}
